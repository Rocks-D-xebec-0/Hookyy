{
  "name": "hookyy",
  "version": "0.1.1",
  "description": "See how much of your test run is spent in hooks and what to change: slow, costly, failing and unused Cucumber, Playwright, Cypress and WebdriverIO hooks. No test code changes.",
  "license": "MIT",
  "author": {
    "name": "Mosbah Houcem Eddine",
    "url": "https://github.com/Rocks-D-xebec-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rocks-D-xebec-0/Hookyy.git"
  },
  "homepage": "https://github.com/Rocks-D-xebec-0/Hookyy#readme",
  "bugs": {
    "url": "https://github.com/Rocks-D-xebec-0/Hookyy/issues"
  },
  "keywords": [
    "cucumber",
    "playwright",
    "cypress",
    "webdriverio",
    "cucumber-jvm",
    "hooks",
    "beforeEach",
    "test-performance",
    "e2e",
    "ci",
    "audit"
  ],
  "bin": {
    "hookyy": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./playwright-reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "require": "./dist/playwright-reporter.js",
      "import": "./dist/playwright-reporter.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.33",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
